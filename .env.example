# Port the server listens on
PORT=3000
# Public URL of this server, used in embed snippets and review links
PUBLIC_URL=http://localhost:3000
# Google Maps Platform key with the "Places API (New)" enabled.
# Leave empty to run in demo mode with sample reviews.
GOOGLE_PLACES_API_KEY=
# How long fetched reviews are cached in memory, in seconds
CACHE_TTL_SECONDS=3600
# Where agencies and widgets are stored
DATA_FILE=data/db.json
