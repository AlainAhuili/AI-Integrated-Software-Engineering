{
  "name": "reputation-widget",
  "version": "0.1.0",
  "description": "White-label Google review & reputation widget for niche agencies",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "create-agency": "node --env-file-if-exists=.env scripts/create-agency.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
